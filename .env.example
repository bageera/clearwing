# Nightwing environment configuration template.
# Copy to .env and fill in values. Never commit .env.

# --- LLM Provider Credentials ---
# Option 1: Anthropic direct
ANTHROPIC_API_KEY=

# Option 2: OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio, etc.)
NIGHTWING_BASE_URL=
NIGHTWING_API_KEY=
NIGHTWING_MODEL=

# Option 3: OpenAI direct
OPENAI_API_KEY=

# Option 4: Google Gemini
GOOGLE_API_KEY=

# Option 5: Ollama Cloud
OLLAMA_API_KEY=

# --- Optional: Metasploit RPC ---
NIGHTWING_MSF_PASSWORD=